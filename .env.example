# ---------- Database (Neon PostgreSQL) ----------
# Neon dashboard -> Connect. DATABASE_URL = pooled connection, DIRECT_URL = direct (non-pooled) connection.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------- Authentication (Clerk) ----------
# Clerk dashboard -> API Keys. The publishable key is needed twice (server + browser).
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxx

# Comma-separated emails that become Super Admin when they sign in.
SUPER_ADMIN_EMAILS=you@example.com

# ---------- Payments (Razorpay LIVE mode) ----------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Optional: secret you set when creating the webhook (event: payment.captured / order.paid)
RAZORPAY_WEBHOOK_SECRET=

# ---------- Server ----------
PORT=4000

# ---------- Deployment (production) ----------
# VERCEL (website) ONLY: the address of your deployed backend, no trailing slash, e.g. https://glamora-api.onrender.com
# Leave it empty for local development (Vite proxies /api to localhost:4000).
# It is baked in when the site is built, so redeploy Vercel after changing it.
VITE_API_URL=

# RENDER / RAILWAY (backend) ONLY: extra websites allowed to call the API, comma-separated.
# https://glamora.vimsenterprise.com and https://glamora-zeta.vercel.app are already built in.
CORS_ORIGINS=
