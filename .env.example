# ---------- Database (Neon PostgreSQL) ----------
# Neon dashboard -> Connect. DATABASE_URL = pooled connection, DIRECT_URL = direct (non-pooled) connection.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------- Authentication (Clerk) ----------
# Clerk dashboard -> API Keys. The publishable key is needed twice (server + browser).
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxx

# Comma-separated emails that become Super Admin when they sign in.
SUPER_ADMIN_EMAILS=you@example.com

# ---------- Payments (Razorpay LIVE mode) ----------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Optional: secret you set when creating the webhook (event: payment.captured / order.paid)
RAZORPAY_WEBHOOK_SECRET=

# ---------- Server ----------
PORT=4000

# ---------- Deployment (production on Vercel) ----------
# The website and the API both run on Vercel, so VITE_API_URL stays EMPTY.
VITE_API_URL=

# Optional: extra website addresses allowed to call the API, comma-separated (for example a Vercel preview URL).
CORS_ORIGINS=
