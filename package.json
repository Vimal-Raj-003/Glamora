{
  "name": "glamora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "postinstall": "prisma generate",
    "check:env": "node scripts/check-env.mjs",
    "offer:on": "node scripts/test-offer.mjs on",
    "offer:off": "node scripts/test-offer.mjs off",
    "db:push": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/prisma/build/index.js db push",
    "db:seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env prisma/seed.js",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:studio": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/prisma/build/index.js studio",
    "test": "node --test test/*.test.js",
    "db:upi:migrate": "node scripts/migrate-upi.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.0.0",
    "@clerk/express": "^1.3.0",
    "@prisma/client": "^6.0.0",
    "codemode-upi-pay": "github:codemodeai/codemode-upi-pay#144be72cca2f94a3ffb0fd14c9e56f34339fc2dc",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "pg": "^8.23.1",
    "prisma": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
